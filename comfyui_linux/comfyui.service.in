[Unit]
Description=Seoul Studio ComfyUI (LTX 2.3)
After=network.target

[Service]
Type=simple
User=comfy
Group=comfy
WorkingDirectory=@INSTALL_ROOT@/ComfyUI
Environment=PYTHONUNBUFFERED=1
ExecStart=@INSTALL_ROOT@/venv/bin/python main.py --listen @LISTEN_IP@ --port @PORT@ --reserve-vram 8 --disable-auto-launch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
