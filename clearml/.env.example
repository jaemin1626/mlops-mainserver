# ──────────────────────────────────────────────────────────────────────────
# ClearML MLOps 통합 설정 — 이 파일만 수정하세요
#
#   cp .env.example .env
#   vi .env
#   bash start.sh
#
#   apply-env.sh 가 URL·DATASET_EXPORT_PATH 등 파생 값을 자동 계산합니다.
# ──────────────────────────────────────────────────────────────────────────

# ── ClearML 서버 (이 서버) ───────────────────────────────────────────────
CLEARML_SERVER_IP=172.16.4.82
CLEARML_WEB_PORT=8080
CLEARML_API_PORT=8008
CLEARML_FILES_PORT=8081

# ── 모니터링 (같은 서버면 CLEARML_SERVER_IP 와 동일) ─────────────────────
MONITORING_SERVER_IP=172.16.4.82
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091
EXPORTER_PORT=9090

# ── 학습 서버 / Dataset NFS ───────────────────────────────────────────────
TRAINING_SERVER_IP=172.16.4.168
TRAINING_SERVER_USER=user
TRAINING_DATASET_PATH=/home/snowa/trainServer/mlops-trainserver/Dataset
HOST_DATASET_PATH=/opt/clearml/data/datasets
NFS_MOUNT_OPTS=rw,nfsvers=4,soft,timeo=30,retrans=2

# ── ClearML 로그인 (gen-auth.sh 가 비어 있으면 생성) ─────────────────────
CLEARML_LOGIN_USER=
CLEARML_LOGIN_PASSWORD=
CLEARML_LOGIN_NAME="Intellivix Admin"

# ── ClearML 서명 키 (gen-secrets.sh 가 생성) ─────────────────────────────
CLEARML_TOKEN_SECRET=
CLEARML_SESSION_SECRET=

# ── Monitoring API 키 (ClearML 웹 → Settings → Create credentials) ───────
CLEARML_ACCESS_KEY=
CLEARML_SECRET_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Monitoring 수집 ───────────────────────────────────────────────────────
SCRAPE_INTERVAL_SEC=60
FREQUENCY_WINDOW_DAYS=30
# Grafana 대시board 호스트 별칭 (선택)
# 예: 1bc44d31189f=DGX-A100,ailab13=AILAB13
SERVER_HOST_ALIASES=

# ── ClearML agent-services (선택) ─────────────────────────────────────────
# 비우면 CLEARML_ACCESS_KEY / CLEARML_SECRET_KEY 를 agent 가 사용
CLEARML_AGENT_ACCESS_KEY=
CLEARML_AGENT_SECRET_KEY=
CLEARML_AGENT_GIT_USER=
CLEARML_AGENT_GIT_PASS=
CLEARML_AGENT_UPDATE_VERSION=>=0.17.0

# ── agent 클라우드 스토리지 (선택, 미사용 시 비움) ─────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ── 아래는 apply-env.sh 가 자동 설정 (직접 수정 불필요) ───────────────────
# CLEARML_HOST_IP=
# CLEARML_WEB_HOST=
# CLEARML_FILES_HOST=
# DATASET_EXPORT_PATH=
# CLEARML_API_HOST=
# SERVER_HOST=
