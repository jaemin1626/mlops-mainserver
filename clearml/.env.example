# ──────────────────────────────────────────────────────────────────────────
# MLOps 통합 설정 — 이 파일만 수정하세요
#
#   cp .env.example .env
#   vi .env
#   bash start.sh
#
#   IP·URL 파생 값은 packaging/apply-env.sh 가 자동 계산합니다.
# ──────────────────────────────────────────────────────────────────────────

# ── MLOps 서버 (ClearML · Seoul Studio · Data Studio · Grafana) ─────────
CLEARML_SERVER_IP=172.16.4.82
CLEARML_WEB_PORT=8080
CLEARML_API_PORT=8008
CLEARML_FILES_PORT=8081

MONITORING_SERVER_IP=172.16.4.82
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091
EXPORTER_PORT=9090

# ── 학습·생성 서버 (ComfyUI · Dataset/영상 NFS) ───────────────────────────
TRAINING_SERVER_IP=172.16.4.81
COMFYUI_PORT=8188
TRAINING_SERVER_USER=user
TRAINING_DATASET_PATH=/home/intellivix/train/Dataset
TRAINING_GENERATED_PATH=/home/intellivix/train/ComfyUI/generate_datasets

# 82 서버 로컬 마운트 지점
HOST_DATASET_PATH=/opt/clearml/data/datasets
MLOPS_GENERATED_MOUNT_PATH=/opt/clearml/data/generate_datasets

NFS_MOUNT_OPTS=rw,nfsvers=4,soft,timeo=30,retrans=2

# ── Seoul Studio (경로만, IP는 TRAINING_SERVER_IP 사용) ───────────────────
SEOUL_STUDIO_CONFIG_PATH=/opt/ComfyUI_seoul/data/config

# ── ClearML 로그인 (비우면 start.sh / gen-auth.sh 가 생성) ────────────────
CLEARML_LOGIN_USER=
CLEARML_LOGIN_PASSWORD=
CLEARML_LOGIN_NAME="Intellivix Admin"

# ── ClearML 서명 키 (비우면 gen-secrets.sh 가 생성) ───────────────────────
CLEARML_TOKEN_SECRET=
CLEARML_SESSION_SECRET=

# ── Grafana (선택) ───────────────────────────────────────────────────────
CLEARML_ACCESS_KEY=
CLEARML_SECRET_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Monitoring 수집 (선택) ───────────────────────────────────────────────
SCRAPE_INTERVAL_SEC=60
FREQUENCY_WINDOW_DAYS=30
SERVER_HOST_ALIASES=

# ── ClearML agent-services (선택) ─────────────────────────────────────────
CLEARML_AGENT_ACCESS_KEY=
CLEARML_AGENT_SECRET_KEY=
CLEARML_AGENT_GIT_USER=
CLEARML_AGENT_GIT_PASS=
CLEARML_AGENT_UPDATE_VERSION=>=0.17.0

# ── agent 클라우드 스토리지 (선택) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ── 아래는 apply-env.sh / start.sh 가 자동 설정 (직접 수정 불필요) ────────
# CLEARML_HOST_IP=
# CLEARML_WEB_HOST=
# CLEARML_FILES_HOST=
# CLEARML_API_HOST=
# SERVER_HOST=
# DATASET_EXPORT_PATH=
# GENERATED_EXPORT_PATH=
# SEOUL_STUDIO_COMFY_URL=          ← http://TRAINING_SERVER_IP:COMFYUI_PORT

# SSH 원격 학습 (기존 NFS/ComfyUI 주소와 독립)
TRAINING_SSH_HOST=172.16.4.83
TRAINING_SSH_PORT=22
TRAINING_SSH_USER=intellivix
TRAINING_SSH_ROOT=/home/intellivix/train
TRAINING_SSH_SCRIPT=./scripts/remote_train.sh
# 실제 학습 서버의 실행 가능한 테스트 스크립트 경로
TRAINING_SSH_TEST_SCRIPT=
# 개인키 내용 대신 호스트 디렉터리 경로만 지정 (읽기 전용 마운트)
TRAINING_SSH_DIR=/opt/clearml/ssh
# SSH 디렉터리 소유자 UID/GID (id -u / id -g)
TRAINING_SSH_UID=1000
TRAINING_SSH_GID=1000

TRAINING_SSH_METRICS_SCRIPT=./scripts/check_metrics.sh
TRAINING_METRICS_INTERVAL_SEC=5

# Detector annotation 전송 대상 (training-ssh 서비스에서 사용)
TRAINING_ANNOTATION_DIR=/home/intellivix/train/Detector/annotation
TRAINING_ANNOTATION_DATE_FORMAT=%Y%m%d

ANNOTATION_API_TOKEN=change-this-long-random-token
ANNOTATION_API_PORT=8091
TRAINING_DATASET_LOCAL_ROOT=/opt/clearml/data/datasets/detector
