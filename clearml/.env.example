# ── MLOps 서버 (ClearML · Seoul Studio · Data Studio · Grafana) ─────────
CLEARML_SERVER_IP=172.16.4.168
CLEARML_WEB_PORT=8080
CLEARML_API_PORT=8008
CLEARML_FILES_PORT=8081

#   MLOPS_ROOT      : mlops-mainserver 저장소 위치
#   CLEARML_DIR_PATH: ClearML 디렉터리 (기본 = MLOPS_ROOT/clearml)
MLOPS_ROOT=/home/snowa/mlops-mainserver
CLEARML_DIR_PATH=${MLOPS_ROOT}/clearml

MONITORING_SERVER_IP=172.16.4.168
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091
EXPORTER_PORT=9090

# ── 학습·생성 서버 (ComfyUI · Dataset/영상 NFS) ───────────────────────────
TRAINING_SERVER_IP=172.16.4.113
COMFYUI_PORT=8188
TRAINING_SERVER_USER=ailab13
# 학습 서버 루트 경로 (Dataset·생성 영상 경로가 여기서 파생됨)
TRAINING_ROOT=/media/ailab13/4TB_SSD1/mlops-trainserver
TRAINING_DATASET_PATH=${TRAINING_ROOT}/Dataset
TRAINING_GENERATED_PATH=${TRAINING_ROOT}/ComfyUI/generate_datasets

# 82 서버 로컬 마운트 지점
HOST_DATASET_PATH=${CLEARML_DIR_PATH}/data/datasets
MLOPS_GENERATED_MOUNT_PATH=${CLEARML_DIR_PATH}/data/generate_datasets

NFS_MOUNT_OPTS=rw,nfsvers=4,soft,timeo=30,retrans=2

# ── Seoul Studio (경로만, IP는 TRAINING_SERVER_IP 사용) ───────────────────
SEOUL_STUDIO_CONFIG_PATH=${MLOPS_ROOT}/ComfyUI_seoul/data/config

# ── ClearML 로그인 (비우면 start.sh / gen-auth.sh 가 생성) ────────────────
CLEARML_LOGIN_USER=
CLEARML_LOGIN_PASSWORD=
CLEARML_LOGIN_NAME="Intellivix Admin"

# ── ClearML 서명 키 (비우면 gen-secrets.sh 가 생성) ───────────────────────
CLEARML_TOKEN_SECRET=
CLEARML_SESSION_SECRET=

# ── Grafana (선택) ───────────────────────────────────────────────────────
CLEARML_ACCESS_KEY=
CLEARML_SECRET_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Monitoring 수집 (선택) ───────────────────────────────────────────────
SCRAPE_INTERVAL_SEC=60
FREQUENCY_WINDOW_DAYS=30
SERVER_HOST_ALIASES=

# ── ClearML agent-services (선택) ─────────────────────────────────────────
CLEARML_AGENT_ACCESS_KEY=
CLEARML_AGENT_SECRET_KEY=
CLEARML_AGENT_GIT_USER=
CLEARML_AGENT_GIT_PASS=
CLEARML_AGENT_UPDATE_VERSION=">=0.17.0"

# ── agent 클라우드 스토리지 (선택) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ── 아래는 apply-env.sh / start.sh 가 자동 설정 (직접 수정 불필요) ────────
# CLEARML_HOST_IP=
# CLEARML_WEB_HOST=
# CLEARML_FILES_HOST=
# CLEARML_API_HOST=
# SERVER_HOST=
# DATASET_EXPORT_PATH=
# GENERATED_EXPORT_PATH=
# SEOUL_STUDIO_COMFY_URL=          ← http://TRAINING_SERVER_IP:COMFYUI_PORT

# SSH 원격 학습 (접속 호스트는 TRAINING_SERVER_IP 와 동일)
TRAINING_SSH_HOST=${TRAINING_SERVER_IP}
TRAINING_SSH_PORT=22
TRAINING_SSH_USER=${TRAINING_SERVER_USER}
TRAINING_SSH_ROOT=${TRAINING_ROOT}
TRAINING_SSH_SCRIPT=./scripts/remote_train.sh
# 실제 학습 서버의 실행 가능한 테스트 스크립트 경로
TRAINING_SSH_TEST_SCRIPT=
# 개인키 내용 대신 호스트 디렉터리 경로만 지정 (읽기 전용 마운트)
TRAINING_SSH_DIR=${CLEARML_DIR_PATH}/ssh
# SSH 디렉터리 소유자 UID/GID (id -u / id -g)
TRAINING_SSH_UID=1000
TRAINING_SSH_GID=1000

TRAINING_SSH_METRICS_SCRIPT=./scripts/check_metrics.sh
TRAINING_METRICS_INTERVAL_SEC=5

# Detector annotation 전송 대상 (training-ssh 서비스에서 사용)
TRAINING_ANNOTATION_DIR=${TRAINING_SSH_ROOT}/Detector/annotation
TRAINING_ANNOTATION_DATE_FORMAT=%Y%m%d

ANNOTATION_API_TOKEN=change-this-long-random-token
ANNOTATION_API_PORT=8091
TRAINING_DATASET_LOCAL_ROOT=${HOST_DATASET_PATH}/detector
