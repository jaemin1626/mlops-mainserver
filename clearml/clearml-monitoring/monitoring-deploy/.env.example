# ──────────────────────────────────────────────────────────────
# ClearML Monitoring Stack 환경 변수
# 복사 후 실제 값으로 수정하세요: cp .env.example .env
#
# ★ 주소·포트는 여기서 직접 고치지 말 것.
#   /opt/clearml/servers.conf 를 고치고 아래를 실행하면 자동으로 반영된다.
#     /opt/clearml/packaging/apply-servers.sh --restart
#
#   [자동 반영] CLEARML_API_HOST, SERVER_HOST, *_PORT,
#               TAGGING_TOOL_URL, GITLAB_URL, GITLAB_PROJECT_IDS
#   [수동 관리] API 키, Grafana 비밀번호, GITLAB_TOKEN, 수집 설정
# ──────────────────────────────────────────────────────────────

# ── ClearML API 서버 주소 (servers.conf 에서 자동 반영) ────────
# 모니터링이 ClearML 과 같은 서버면 host.docker.internal 이 들어간다.
CLEARML_API_HOST=http://host.docker.internal:8008

# ── ClearML API Key (서버마다 다름 — 직접 발급해서 교체) ──────
# ClearML 웹 → 프로필 → Settings → Workspace
# → Create new credentials 에서 발급
CLEARML_ACCESS_KEY=
CLEARML_SECRET_KEY=

# ── 서버 호스트 (servers.conf 에서 자동 반영) ─────────────────
SERVER_HOST=127.0.0.1

# ── 포트 설정 (servers.conf 에서 자동 반영) ───────────────────
EXPORTER_PORT=9090
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# ── Grafana 관리자 계정 ────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=clearml123!

# ── 태깅 툴 주소 (servers.conf 에서 자동 반영) ───────────────
TAGGING_TOOL_URL=

# ── GitLab (URL·PROJECT_IDS 는 servers.conf 에서 자동 반영) ───
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT_IDS=

# ── 수집 설정 ─────────────────────────────────────────────────
SCRAPE_INTERVAL_SEC=60
FREQUENCY_WINDOW_DAYS=30
