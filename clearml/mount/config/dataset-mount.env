# ──────────────────────────────────────────────────────────────────────────
# Data Studio 연동용 Dataset 마운트 설정
#
#   ★ 사용자는 이 파일만 수정하면 됩니다.
#
#   경로는 3단계입니다 (이름이 다른 이유):
#
#     [학습 서버]  TRAINING_SERVER_IP:TRAINING_DATASET_PATH
#           │  NFS mount
#           ▼
#     [ClearML 호스트]  HOST_DATASET_PATH          ← 아래에서 설정
#           │  docker bind (compose.yml, 자동)
#           ▼
#     [Data Studio 컨테이너]  /data/datasets       ← 고정, 바꿀 필요 없음
#
#   사용 (이것만 실행하면 됨):
#     bash /opt/clearml/start.sh
#     bash /opt/clearml/mount/scripts/mount_dataset.sh status   # 상태만 확인
# ──────────────────────────────────────────────────────────────────────────

# 학습 서버 IP
TRAINING_SERVER_IP=172.16.4.168

# 학습 서버 Dataset 경로 (NFS export 대상)
TRAINING_DATASET_PATH=/home/snowa/trainServer/mlops-trainserver/Dataset

# ClearML 서버 호스트 경로 (Data Studio 가 여기를 /data/datasets 로 봄)
HOST_DATASET_PATH=/opt/clearml/data/datasets

# NFS mount 옵션
NFS_MOUNT_OPTS=rw,nfsvers=4,soft,timeo=30,retrans=2