--- scripts/vlm_options.py
+++ scripts/vlm_options.py
@@ -0,0 +1,50 @@
+"""VLM UI field -> launcher option -> train.env key, shared by probe and API."""
+SPECS = {
+ 'modality': ('--modality','TRAIN_MODALITY','enum:image,video,both'),
+ 'mode': ('--mode','TRAIN_MODE','enum:lora,full'),
+ 'model': ('--model',None,'model'),
+ 'train_json': ('--annotation','TRAIN_JSON','json'),
+ 'val_json': ('--val-json','VAL_JSON','json'),
+ 'epochs': ('--epochs','EPOCHS','int:1'),
+ 'batch': ('--batch','BATCH_SIZE','int:1'),
+ 'gradient_accumulation': ('--gradient-accumulation','GRAD_ACCUM','int:1'),
+ 'learning_rate': ('--learning-rate','LEARNING_RATE','positive'),
+ 'max_length': ('--max-length','MAX_SEQ_LENGTH','int:1'),
+ 'workers': ('--workers','DATALOADER_NUM_WORKERS','int:0'),
+ 'gpu': ('--gpu','DEVICE','gpu'),
+ 'name': ('--name','CLEARML_TASK','name'),
+ 'lora_rank': ('--lora-rank','LORA_R','int:1'),
+ 'lora_alpha': ('--lora-alpha','LORA_ALPHA','int:1'),
+ 'lora_dropout': ('--lora-dropout','LORA_DROPOUT','dropout'),
+ 'lora_target_modules': ('--lora-target-modules','LORA_TARGET_MODULES','modules'),
+ 'gradient_checkpointing': ('--gradient-checkpointing','GRADIENT_CHECKPOINTING','bool'),
+ 'video_fps': ('--video-fps','VIDEO_FPS','positive'),
+ 'video_max_pixels': ('--video-max-pixels','VIDEO_MAX_PIXELS','int:1'),
+ 'validation_ratio': ('--validation-ratio','VALID_RATIO','ratio'),
+ 'validation_seed': ('--validation-seed','VALID_SPLIT_SEED','int:0'),
+ 'max_samples': ('--max-samples','MAX_SAMPLES','int:1'),
+ 'eval_steps': ('--eval-steps','EVAL_STEPS','integer'),
+ 'logging_steps': ('--logging-steps','LOGGING_STEPS','int:1'),
+ 'save_steps': ('--save-steps','SAVE_STEPS','int:0'),
+ 'save_total_limit': ('--save-total-limit','SAVE_TOTAL_LIMIT','int:1'),
+}
+LORA = {'lora_rank','lora_alpha','lora_dropout','lora_target_modules'}
+VIDEO = {'video_fps','video_max_pixels'}
+
+import math
+import re
+
+def value_valid(key,value):
+    kind=SPECS[key][2]
+    if kind.startswith('int:') or kind=='integer':
+        if type(value) is not int or (kind.startswith('int:') and value<int(kind.split(':')[1])):raise ValueError(key+': 정수 범위 오류')
+    elif kind in {'positive','ratio','dropout'}:
+        if type(value) not in {int,float} or not math.isfinite(value) or (kind=='positive' and value<=0) or (kind=='ratio' and not 0<value<1) or (kind=='dropout' and not 0<=value<1):raise ValueError(key+': 수치 범위 오류')
+    elif kind.startswith('enum:'):
+        if value not in kind[5:].split(','):raise ValueError(key+': 잘못된 선택')
+    elif kind=='bool':
+        if type(value) is not bool:raise ValueError(key+': boolean 필요')
+    elif kind in {'name','modules'}:
+        pattern=r'[A-Za-z0-9_-]+' if kind=='name' else r'[A-Za-z0-9_.]+(?:,[A-Za-z0-9_.]+)*'
+        if not isinstance(value,str) or not re.fullmatch(pattern,value) or len(value)>256:raise ValueError(key+': 잘못된 문자')
+    elif not isinstance(value,str) or not value or len(value)>1024 or any(ord(c)<32 for c in value):raise ValueError(key+': 잘못된 경로 또는 GPU')
